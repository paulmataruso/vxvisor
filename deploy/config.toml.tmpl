# VDXClone host config — generated by install.sh.
# __BIND_IP__ is replaced with the host's chosen IP at install time.

[server]
# Admin/management UI. Keep this on the LAN or behind a VPN.
addr = "__BIND_IP__:8766"
vnc_port_base = 5900

[paths]
data_dir   = "/var/lib/vdxclone/data"
image_dir  = "/var/lib/vdxclone/images"
disk_dir   = "/var/lib/vdxclone/disks"
iso_dir    = "/var/lib/vdxclone/isos"
backup_dir = "/var/lib/vdxclone/backups"

[network]
# "user" = QEMU user-mode networking (no bridge needed, works anywhere).
# Switch to "bridge"/"overlay" on a real cluster — see docs/CLUSTER-NETWORKING.md.
mode = "user"
forward_host = "__BIND_IP__"
forward_port_base = 20000

[vm]
# vdxd drops to this unprivileged user to run QEMU. install.sh creates it.
run_as = "vdx"

[gateway]
# Full browser desktop via guacd. In user-net mode this resolves to VNC against
# the loopback QEMU display (always works); with bridge/overlay networking and a
# guest running xrdp it upgrades to RDP (clipboard/audio/mic/webcam).
enabled = true
guacd_addr = "127.0.0.1:4822"
protocol = "rdp"

[cluster]
# Decentralized membership over mDNS + gossip, no central coordinator. Overlay
# (VXLAN) stays off until you set network mode to "overlay" on a multi-node
# cluster. See docs/CLUSTER-NETWORKING.md.
mdns = true
gossip_port = 7946
vni = 42
bridge = "vdxbr0"
subnet = "10.77.0.0/16"
gateway = "10.77.0.1"
migrate_port = 49200

[public]
# Internet-facing VDI portal (login + My Desktops + desktop gateway only — no
# admin screens). For real internet exposure, bind this to loopback and front it
# with a TLS reverse proxy (Caddy/nginx) — see docs/VDI-GATEWAY.md. For LAN
# testing it is bound to the host IP so you can reach it directly.
enabled  = true
addr     = "__BIND_IP__:8768"
base_url = "http://__BIND_IP__:8768"

[broker]
idle_minutes = 30
# secret_file defaults to <data_dir>/broker.key (auto-created, 0600).
