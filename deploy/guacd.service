[Unit]
Description=Apache Guacamole proxy daemon (guacd)
Documentation=https://guacamole.apache.org/
After=network.target

[Service]
Type=simple
# Dedicated unprivileged user; binds loopback only so guacd is never exposed.
User=guacd
Group=guacd
ExecStart=/usr/local/sbin/guacd -b 127.0.0.1 -L info -f
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
