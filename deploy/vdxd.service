[Unit]
Description=VDXClone VM/VDI control plane (vdxd)
Documentation=https://github.com/ (internal)
After=network-online.target
Wants=network-online.target
# guacd backs the browser-desktop gateway; start it first when present.
After=guacd.service
Wants=guacd.service

[Service]
Type=simple
# vdxd starts as root (to create bridges / taps / open low ports) and itself
# drops privilege to the configured [vm].run_as user before launching QEMU.
User=root
Environment=VDX_CONFIG=/etc/vdxclone/config.toml
Environment=TMPDIR=/var/lib/vdxclone/tmp
ExecStart=/usr/local/bin/vdxd serve
Restart=on-failure
RestartSec=3
# Needs /dev/kvm for accelerated guests and the kvm group for access.
SupplementaryGroups=kvm
# Reasonable hardening that still allows QEMU, bridges, and loopback sockets.
NoNewPrivileges=false
LimitNOFILE=1048576
# Log to the journal.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
